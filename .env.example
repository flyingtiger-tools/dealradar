# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Même URL que ci-dessus, sans le préfixe NEXT_PUBLIC_ : lue par les workers
# (process Node pur, aucun sens à exposer une variable "publique" côté bundle).
SUPABASE_URL=https://xxxx.supabase.co
# Clé service : UNIQUEMENT côté workers / serveur. Jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Base de données (workers, pg-boss) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Ingestion (Lot 4) — connecteur eBay, workers uniquement ──
# API officielles eBay (Browse API). Sandbox recommandé en premier —
# voir ADR 0008 pour la procédure de configuration. Jamais dans apps/web.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_CH
EBAY_ENVIRONMENT=sandbox

# ── Application ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Paiements (Lot 4) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Observabilité ─────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
