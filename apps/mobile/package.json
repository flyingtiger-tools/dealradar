{
  "name": "@dealradar/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__",
    "test": "jest",
    "build": "expo export --platform android"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((\\.pnpm/[^/]+/node_modules/)?(jest-)?react-native|(\\.pnpm/[^/]+/node_modules/)?@react-native|(\\.pnpm/[^/]+/node_modules/)?expo[^/]*|(\\.pnpm/[^/]+/node_modules/)?@expo[^/]*|@unimodules|unimodules)/)"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@dealradar/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~52.0.11",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.4",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "overlay-copilot": "file:./modules/overlay-copilot",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.2",
    "typescript": "^5.7.2"
  }
}
